{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app15",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ce7c487f-096e-44a9-ac63-d9f240b197c0","database_name": "web-app15" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "98301e9b562940a8aee7077867901be9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
